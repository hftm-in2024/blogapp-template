{
  "name": "blogapp-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n app,bff \"ng serve\" \"pnpm run start:bff\"",
    "start:bff": "node -e \"fs.mkdirSync('dist/app/browser',{recursive:true})\" && wrangler dev",
    "test:bff": "tsc -p worker && vitest run --dir worker",
    "deploy": "ng build && wrangler deploy",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch",
    "test:ci": "ng test --no-watch --coverage --coverage-reporters=text-summary --coverage-reporters=json-summary",
    "lint": "ng lint",
    "format": "prettier --write ./src/app/*",
    "prepare": "husky",
    "analyze:deps:all": "madge src/main.ts --ts-config tsconfig.json --image ./deps/blogapp-template/_all.png",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:e2e": "wrangler dev --port 4200 --var OIDC_CLIENT_SECRET:e2e --var OIDC_AUTH_SECRET:e2e-only-secret-with-32-characters"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,js,html}": "eslint --cache --fix",
    "*.{ts,js,html,css,scss,less,md}": "prettier --write"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@hono/oidc-auth": "^1.10.0",
    "hono": "^4.13.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^22.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.148.0"
  }
}
