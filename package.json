{
  "name": "blogapp-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch",
    "test:ci": "ng test --no-watch --coverage --coverage-reporters=text-summary --coverage-reporters=json-summary",
    "lint": "ng lint",
    "format": "prettier --write ./src/app/*",
    "prepare": "husky",
    "analyze:deps:all": "madge src/main.ts --ts-config tsconfig.json --image ./deps/blogapp-template/_all.png",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:e2e": "serve dist/app/browser -l 4200 --single"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,js,html}": "eslint --cache --fix",
    "*.{ts,js,html,css,scss,less,md}": "prettier --write"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.8"
  }
}
